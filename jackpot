local questDefs = {
	{id = "q_slots_5", name = "SLOT ENTHUSIAST", desc = "Play slots 5 times", goal = 5, reward = 200},
	{id = "q_win_3", name = "WINNING STREAK", desc = "Win 3 games in a row", goal = 3, reward = 300},
