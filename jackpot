	end
	
	-- KENO
	local kenoBet, kenoNums = string.match(input, "^keno%s+(%d+)%s+(.+)$")
	if kenoBet then
		return playKeno(tonumber(kenoBet), kenoNums)
	end
	
	-- LOTTERY
	local lotMatch = string.match(input, "^lottery%s+(%d+)$")
	if lotMatch then
		return playLottery(tonumber(lotMatch))
	end
	
	-- WAR
	local warMatch = string.match(input, "^war%s+(%d+)$")
	if warMatch then
